generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShortUrl {
  id        String   @id @default(cuid())
  shortCode String   @unique
  longUrl   String
  createdAt DateTime @default(now())

  @@index([shortCode])
}
